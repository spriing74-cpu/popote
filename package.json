{
  "name": "popote",
  "private": true,
  "version": "1.0.0",
  "description": "Popote — planning des repas et liste de courses pour deux (PWA hors ligne)",
  "type": "module",
  "scripts": {
    "scan-assets": "node scripts/copy-scan-assets.mjs",
    "predev": "node scripts/copy-scan-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-scan-assets.mjs && node scripts/fetch-insee-prices.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "node scripts/generate-icons.mjs",
    "prices": "node scripts/fetch-insee-prices.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/fra": "^1.0.0",
    "barcode-detector": "^3.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
